{
  "name": "kayan-payroll",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "نظام كيان لإدارة الرواتب — تطبيق محلي",
  "author": "Kayan",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win nsis",
    "test:daily:e2e": "node scripts/daily-smoke.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "test:admin:e2e": "node scripts/admin-smoke.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "release": "node scripts/release.mjs"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "build": {
    "appId": "com.kayan.payroll",
    "productName": "Kayan Payroll",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/brand/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kareem333j",
        "repo": "kayan-finance-system",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "decimal.js": "10.6.0",
    "electron-updater": "^6.8.9",
    "exceljs": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "^1.14.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
